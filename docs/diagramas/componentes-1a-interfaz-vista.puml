@startuml componentes-1a-interfaz-vista
' SmartHouse3D - Diagrama de componentes, parte 1a de 4: LA INTERFAZ, lo que se ve
' Fuentes: src/components/, src/three/, src/store/
title SmartHouse3D · Componentes (1a de 4) · Interfaz: pantalla, escena 3D y estado

skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowFontSize 11
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #475569
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
}

package "Pantalla · src/components" as pres {
  component "Header\nestado, sesión y vídeo guía" as header
  component "Viewer\ncontenedor de la casa en 3D" as viewer
  component "ControlPanel\nluces, clima, enchufes, accesos" as panel
  component "Charts + RangeTabs\ngráficas en vivo e historial" as charts
  component "KpiCards + EventLog\nresumen y registro" as kpi
  component "PipelineStatus\nlas 4 tarjetas de transparencia" as pipeline
  component "SessionOverlays\nemparejar y confirmar con código" as overlays
  component "WalkHud\nmandos del recorrido" as walkhud
}

package "Escena 3D · src/three · Three.js" as escena {
  component "HouseScene\nmodelo casa.glb" as house
  component "LightRig\nbombillos y su luz real" as lights
  component "ClimateLayer\ncolor por temperatura" as climate
  component "AcLayer · PlugLayer\nSensorLayer · DoorAnimator" as layers
  component "WalkMode\ncámara en primera persona" as walkmode
}

package "Estado · src/store · Zustand" as estado {
  component "useHouseStore\nestado de la casa, solo lectura" as housestore
  component "useSessionStore\nrol, alias y confirmaciones" as sessionstore
  component "useUiStore\npreferencias de la pantalla" as uistore
}

viewer --> house
house --> lights
house --> climate
house --> layers
walkhud --> walkmode
walkmode --> house

header --> uistore : "sonido y analítica"
walkhud --> uistore
header --> sessionstore
overlays --> sessionstore
panel --> sessionstore : "¿puede este rol?"

panel --> housestore
charts --> housestore
kpi --> housestore
pipeline --> housestore
lights --> housestore
climate --> housestore
layers --> housestore

note bottom of estado
  **La interfaz nunca adopta un modelo optimista.**
  Pulsar un botón no cambia el estado: se envía la
  orden y el estado solo cambia cuando Node-RED
  confirma. Si la orden se rechaza, la pantalla
  no miente.
end note

note right of escena
  La geometría y las posiciones salen de
  house.config.ts, la misma configuración
  que alimenta el flujo de Node-RED
  (ver parte 3).
end note

@enduml
