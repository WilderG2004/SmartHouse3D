@startuml componentes-3-contratos
' SmartHouse3D - Diagrama de componentes, parte 3 de 4: CONTRATOS Y GENERACION
' Fuentes: src/config/house.config.ts, infra/nodered/tools/security-policy.mts,
'          infra/nodered/tools/build-flows.mts, infra/nodered/tools/generar-flujo-render.mjs
title SmartHouse3D · Componentes (3 de 4) · Contratos compartidos y generación del flujo

skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowFontSize 11
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #475569
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
}

package "Fuentes únicas de verdad" as fuentes {
  component "house.config.ts\nhabitaciones, luces, puertas,\nsensores, aires y enchufes" as houseconf
  component "security-policy.mts\nroles, tabla de permisos por tipo\nde orden, esquema de telemetría,\nprivacidad y límites" as secpol
  component "types/iot.ts\ncontrato de los mensajes" as tipos
}

package "Generadores" as gen {
  component "build-flows.mts\narma el flujo nodo a nodo" as build
  component "generar-flujo-render.mjs\nadapta el flujo a Render" as genrender
}

package "Artefactos generados\nNO se editan a mano" as art {
  artifact "flows.json\nDocker" as f1
  artifact "flows.local.json\ndesarrollo local" as f2
  artifact "flows.render.json\nproducción" as f3
  artifact "flows_cred.json\nsolo referencias a los tokens" as fc
}

package "Consumidores" as cons {
  component "Interfaz React\nescena 3D y paneles" as ui
  component "security.config.ts\nCOPIA de la tabla de permisos,\nsolo para desactivar botones" as seccopy
  component "Node-RED\nla validación de verdad" as nr
}

package "Comprobación" as check {
  component "seguridad:probar\n65 pruebas de rechazo" as pruebas
  component "seguridad:integridad\nrecalcula la cadena de huellas" as integridad
}

houseconf --> build : "lee"
secpol --> build : "lee"
houseconf --> ui : "misma configuración"
tipos --> ui
tipos --> nr

build --> f1
build --> f2
build --> fc
f3 <-- genrender
build --> genrender

f1 --> nr
f2 --> nr
f3 --> nr
fc --> nr

secpol ..> seccopy : "**se copia a mano**\nsi cambias un permiso,\ncámbialo en los dos"
seccopy --> ui

pruebas ..> nr : "ataca y comprueba\nque rechaza"
integridad ..> nr

note bottom of fuentes
  Una sola definición de la casa alimenta
  la escena 3D y el flujo de Node-RED: no
  pueden quedar desincronizadas.
end note

note bottom of art
  Se regeneran con:
  npm run nodered:build
  npm run render:flujo
end note

note right of seccopy
  Es la única duplicación consciente del
  proyecto. La interfaz solo decide qué
  botón se ve apagado; quien autoriza de
  verdad es Node-RED.
end note

@enduml
