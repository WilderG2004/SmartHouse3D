@startuml componentes
title SmartHouse3D · Diagrama de componentes

skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam roundcorner 8
skinparam componentStyle uml2
skinparam ArrowColor #334155
skinparam ArrowFontSize 12
skinparam nodesep 35
skinparam ranksep 55
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #475569
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
}
skinparam interface {
  BackgroundColor #D1FAE5
  BorderColor #047857
}
skinparam database {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
}

package "Interfaz web · React" {
  component "Panel de control" as panel
  component "Gráficas" as graficas
  component "Casa 3D" as casa
  component "Emparejamiento" as empareja
  component "Estado" as estado
  component "Adaptador" as adaptador
  interface "TelemetryAdapter" as ITel

  adaptador -up- ITel
  panel ..> ITel
  empareja ..> ITel
  adaptador --> estado
  estado --> panel
  estado --> graficas
  estado --> casa
}

package "Node-RED" {
  component "Autorizar sesión" as auth
  component "Órdenes" as ordenes
  component "Seguridad" as seg
  component "Simulación" as simul
  component "Alertas" as alertas
  component "Filtro de privacidad" as filtro
  component "Preparar puntos" as prepara
  component "Firma y validación" as valida
  component "Auditoría" as audit
  component "API historial" as api
  interface "/ws/casa-iot" as IWs
  interface "/api/history" as IHist

  auth -up- IWs
  filtro -up- IWs
  api -up- IHist
  auth --> ordenes
  auth --> seg
  auth --> audit : "rechazos"
  simul --> alertas
  ordenes --> filtro
  seg --> filtro
  simul --> filtro
  alertas --> filtro
  ordenes --> prepara
  seg --> prepara
  simul --> prepara
  alertas --> prepara
  prepara --> valida
  valida --> audit : "cuarentena"
}

database "Bucket de datos" as bdatos
database "Bucket de huellas" as bhuellas

adaptador ..> IWs : "envía órdenes\nrecibe telemetría"
graficas ..> IHist : "15 min · 1 h · 24 h"
valida ..> bdatos : "puntos"
valida ..> bhuellas : "huellas"
audit ..> bdatos : "auditoría"
api ..> bdatos : "consulta Flux"

@enduml
