@startuml componentes
' Cableado comprobado en infra/nodered/tools/build-flows.mts (secciones A-F)
' y en los 36 nodos de infra/nodered/src/*.js. Nombres tomados de sus cabeceras @name.
title SmartHouse3D · Diagrama de componentes

skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam roundcorner 8
skinparam componentStyle uml2
skinparam ArrowColor #334155
skinparam ArrowFontSize 12
skinparam nodesep 35
skinparam ranksep 50
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #475569
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
}
skinparam interface {
  BackgroundColor #D1FAE5
  BorderColor #047857
}
skinparam database {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
}

package "Interfaz web · React" {
  component "Panel de control" as panel
  component "Gráficas" as graficas
  component "Casa 3D" as casa
  component "Emparejamiento" as empareja
  component "Estado" as estado
  component "Adaptador" as adaptador
  interface "Adaptador de telemetría" as ITel

  adaptador -up- ITel
  panel ..> ITel
  empareja ..> ITel
  adaptador --> estado
  estado --> panel
  estado --> graficas
  estado --> casa
}

package "Node-RED · flujo generado" {
  component "Autorizar sesión" as auth
  component "Enrutador por kind" as router
  component "Manejadores de órdenes\nluces · puertas · PIR · aire\nenchufes · escenas · reloj" as handlers
  component "Seguridad" as seg
  component "Simulación cada 1 s\nhumo · clima · energía" as simul
  component "Alertas" as alertas
  component "Bus de telemetría" as bus
  component "Filtro de privacidad" as filtro
  component "Preparar lecturas" as prepara
  component "Guardar cambios y eventos" as eventos
  component "Firmar telemetría" as firma
  component "Validar telemetría" as valida
  component "Auditoría" as audit
  component "API historial" as api
  component "Monitor del pipeline" as monitor
  interface "/ws/casa-iot" as IWs
  interface "/api/history" as IHist

  auth -up- IWs
  filtro -up- IWs
  api -up- IHist

  auth --> router : "órdenes autorizadas"
  auth --> audit : "rechazos"
  router --> handlers
  router --> seg
  handlers --> bus
  seg --> bus
  seg ..> router : "órdenes internas"
  handlers ..> router : "escenas y temporizadores"
  simul --> alertas
  simul --> bus
  alertas --> bus
  alertas --> prepara
  bus --> filtro
  bus --> eventos
  prepara --> firma
  eventos --> firma
  firma --> valida
  valida --> audit : "cuarentena"
  monitor --> bus : "estado del pipeline"
}

database "Bucket de datos" as bdatos
database "Bucket de huellas" as bhuellas

adaptador ..> IWs : "envía órdenes\nrecibe telemetría"
graficas ..> IHist : "15 min · 1 h · 24 h"
valida ..> bdatos : "puntos aceptados"
valida ..> bhuellas : "huella cada 5 min"
audit ..> bdatos : "auditoría y cuarentena"
api ..> bdatos : "consulta Flux"
monitor ..> bdatos : "relee lo guardado"

@enduml
