@startuml despliegue-1-produccion
' SmartHouse3D - Diagrama de despliegue, parte 1 de 2: PRODUCCION
' Fuentes: render.yaml, infra/nodered/Dockerfile.render, vercel.json,
'          infra/despliegue/README.md, infra/nodered/tools/build-flows.mts
title SmartHouse3D · Despliegue (1 de 2) · Producción

skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowFontSize 11
skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #475569
}
skinparam cloud {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
}
skinparam database {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
}
skinparam component {
  BackgroundColor #D1FAE5
  BorderColor #047857
}

node "Dispositivo del usuario" as cliente {
  node "Navegador web" as nav {
    artifact "Sitio descargado\nHTML + JS + CSS" as bundle
    artifact "Modelo 3D de la casa\ncasa.glb" as glb
    component "Motor 3D\nThree.js sobre WebGL" as webgl
  }
}

cloud "Vercel · CDN global" as vercel {
  artifact "Interfaz React 19\ncompilada con Vite" as sitio
  artifact "vercel.json\nCSP, HSTS, X-Frame-Options,\nPermissions-Policy" as cabeceras
}

cloud "Render · región Virginia" as render {
  component "Proxy TLS de Render\ncertificado y X-Forwarded-For" as proxy
  node "Contenedor Docker\nnodered/node-red:5.0.8-24 · Node 24" as cont {
    component "Node-RED\n72 nodos · 36 funciones" as nr
    artifact "flows.render.json\ndentro de la imagen, solo lectura" as flujo
    artifact "settings.js endurecido\neditor APAGADO" as settings
    artifact "flows_cred.json\nsolo referencias a los tokens,\nnunca sus valores" as cred
  }
}

cloud "InfluxDB Cloud · us-east-1" as influx {
  database "Bucket Casa_IoT\nretención 30 días" as bdatos
  database "Bucket Casa_IoT_integridad\nretención 90 días" as bhuellas
}

nav --> vercel : "HTTPS\ndescarga del sitio"
nav --> proxy : "wss://…/ws/casa-iot\ntelemetría y órdenes"
nav --> proxy : "https://…/api/history/*\nAuthorization: Bearer"
proxy --> nr
nr --> bdatos : "escribe puntos\ntoken de SOLO ESCRITURA"
nr --> bhuellas : "escribe huellas\nde integridad"
bdatos --> nr : "consulta Flux\ntoken de SOLO LECTURA"

note right of render
  **Plan gratuito de Render**
  El servicio se duerme tras 15 minutos
  sin visitas y tarda cerca de un minuto
  en despertar: la primera carga es lenta.
end note

note bottom of vercel
  **Aquí no vive ningún secreto.**
  Todo lo que empieza por VITE_ queda visible
  en el navegador. La única variable con una
  clave es VITE_DEMO_OPERADOR_KEY, publicada
  a propósito para la demostración.
end note

note bottom of influx
  Los valores de los tokens solo existen
  en el panel de Render, nunca en el
  repositorio ni en la imagen Docker.
end note

@enduml
