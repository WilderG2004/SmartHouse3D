@startuml componentes-2-nodered
' SmartHouse3D - Diagrama de componentes, parte 2 de 4: EL BACKEND (Node-RED)
' Fuentes: infra/nodered/src/*.js y las secciones A-F de infra/nodered/tools/build-flows.mts
title SmartHouse3D · Componentes (2 de 4) · Backend Node-RED

skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowFontSize 11
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #475569
}
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
}
skinparam database {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
}
skinparam interface {
  BackgroundColor #D1FAE5
  BorderColor #047857
}

interface "WebSocket\n/ws/casa-iot" as wsin
interface "API REST\n/api/…" as apiin

package "A · Inicialización" as secA {
  component "00-inicializar\nconfiguración, estado y claves" as init
}

package "B · Comandos" as secB {
  component "05-parsear-comando\nforma y tamaño del mensaje" as parse
  component "06-sesion-autorizar\nrol, permisos, rangos,\nconfirmación en dos pasos" as auth
  component "07-sesion-cerrar" as close
  component "08-auditar\nrechazos y anomalías" as audit
  component "10-luces · 20-puertas · 30-pir\n40-aire · 50-enchufes · 70-escenas" as actuadores
  component "60-seguridad\nmodos desarmada, en casa, fuera" as seguridad
}

package "C · Simulación · cada segundo" as secC {
  component "80-mundo\nhora y clima exterior" as mundo
  component "35-expiraciones" as expira
  component "90-humo-simular · 91-humo-tick" as humo
  component "92-clima-tick\ntemperatura y humedad por habitación" as clima
  component "93-energia-tick\nconsumo y acumulado" as energia
  component "94-alertas\numbrales y avisos" as alertas
  component "85-snapshot\nfoto completa al conectarse" as snapshot
}

package "D · Salida" as secD {
  component "97-serializar\nFILTRO DE PRIVACIDAD por sesión" as serial
  component "95-persistir\nlote de puntos cada 2 s" as persistir
  component "96-eventos-influx\ncambios de estado" as eventos
  component "86-firmar-telemetria\nHMAC-SHA256 por dispositivo" as firmar
  component "87-validar-telemetria\nÚNICA puerta hacia InfluxDB" as validar
}

package "E · API REST" as secE {
  component "98-hist-power · 98-hist-smoke\n98-hist-clima\nconsultas Flux" as hist
  component "99-hist-formato" as formato
  component "09-ingesta-recibir\nPOST /api/ingest, apagado" as ingesta
  component "99-salud\nGET /api/health" as salud
  component "99-error\nerror 502 claro" as error
}

package "F · Monitor del pipeline" as secF {
  component "88-pipeline-contar\n88-pipeline-ultimo\nlee lo que acaba de guardar" as monitor
  component "88-pipeline-resultado\n88-pipeline-error" as monres
}

database "Bucket de datos\nCasa_IoT" as bdatos
database "Bucket de huellas\nCasa_IoT_integridad" as bhuellas

wsin --> parse
parse --> auth
auth --> actuadores
auth --> seguridad
auth --> audit : "rechazos"
auth --> close
init ..> secB : "estado compartido"
init ..> secC

mundo --> clima
expira --> humo
humo --> clima
clima --> energia
energia --> alertas

actuadores --> serial
seguridad --> serial
alertas --> serial
snapshot --> serial
serial --> wsin : "telemetría filtrada\nsegún el rol"

actuadores --> eventos
seguridad --> eventos
energia --> persistir
clima --> persistir
persistir --> firmar
eventos --> firmar
firmar --> validar
ingesta --> validar
validar --> bdatos : "puntos aceptados"
validar --> bhuellas : "huella por bloque de 5 min"
validar --> audit : "rechazados y en cuarentena"
audit --> bdatos : "audit, quarantine"

apiin --> hist
apiin --> salud
apiin --> ingesta
hist --> bdatos : "Flux, solo lectura"
hist --> formato
formato --> apiin
error --> apiin
monitor --> bdatos
monitor --> monres
monres --> serial : "estado del pipeline"

note bottom of secD
  **Todo punto pasa por 87-validar-telemetria:**
  firma, ventana de tiempo, número de secuencia,
  esquema, rangos y anomalías. Lo que no pasa,
  no entra en la base de datos.
end note

note right of secB
  La tabla de permisos vive en
  security-policy.mts. Un tipo de orden
  que no esté en ella se rechaza.
end note

@enduml
