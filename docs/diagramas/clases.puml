@startuml clases
' Comprobado en el codigo. Los nombres se muestran en español; el alias de cada
' clase es el identificador real:
'   src/services/telemetry/TelemetryAdapter.ts  interfaz y clase abstracta
'   src/services/telemetry/WebSocketAdapter.ts  SimulatedAdapter.ts  pairingKey.ts
'   src/hooks/useTelemetry.ts                   fachada «commands»
'   src/store/useHouseStore.ts  useSessionStore.ts  useUiStore.ts
'   src/types/iot.ts                            contrato de datos
title SmartHouse3D · Diagrama de clases

skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam roundcorner 6
skinparam ArrowColor #334155
skinparam ArrowFontSize 12
skinparam nodesep 35
skinparam ranksep 55
skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #475569
}
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
}

package "Canal de datos" {
  interface "Adaptador de telemetría" as TelemetryAdapter {
    +origen : simulado | WebSocket
    +etiqueta : texto
    +mandaElServidor : lógico
    +canalCifrado : lógico
    +conectar()
    +desconectar()
    +suscribir(oyente) : cancelar
    +enviar(orden : Orden)
    +emparejar(clave : texto)
    +desemparejar()
    +confirmar(código : texto)
    +revocarOtrasSesiones()
  }

  abstract class "Adaptador base" as BaseAdapter {
    -oyentes : conjunto
    +mandaElServidor = falso
    +canalCifrado = nulo
    +suscribir(oyente) : cancelar
    #emitir(mensaje)
  }

  class "Adaptador WebSocket" as WebSocketAdapter {
    +origen = WebSocket
    +etiqueta = Node-RED (WebSocket)
    +mandaElServidor = verdadero
    -conexión : WebSocket
    -reintentos : número
    -clavePendiente : texto
    +conectar()
    +enviar(orden)
    -normalizar(crudo)
  }

  class "Adaptador simulado" as SimulatedAdapter {
    +origen = simulado
    +etiqueta = SIMULACIÓN LOCAL
    +conectar()
    +enviar(orden)
  }

  class "Clave de la pestaña" as pairingKey <<módulo>> {
    +leer() : texto
    +guardar(clave)
    +borrar()
  }

  BaseAdapter ..|> TelemetryAdapter
  WebSocketAdapter --|> BaseAdapter
  SimulatedAdapter --|> BaseAdapter
  WebSocketAdapter --> pairingKey : "sessionStorage"
}

package "Contrato de mensajes" {
  class "Mensaje de telemetría" as TelemetryMessage <<unión>> {
    foto · luz · humo · movimiento
    puerta · consumo · clima · aire
    enchufe · seguridad · alerta
    evento · tubería · conexión
  }

  class "Orden" as DeviceCommand <<unión>> {
    light.set · door.set · ac.set
    plug.set · security.set
    scene.apply · world.setHour
    smoke.simulate · pir.simulate
  }

  class "Mensaje de sesión" as SessionMessage <<unión>> {
    sesión : rol vigente
    confirmar : código de un solo uso
    rechazo : motivo
  }

  enum "Rol de sesión" as SessionRole {
    lector
    operador
    administrador
  }
}

package "Estado de la casa" {
  class "Estado de la casa" as HouseSnapshot {
    +vistaReducida : lógico
    +movimiento : por sensor
    +consumo : vatios y kWh
    +mundo : hora y temperatura exterior
    +eventos : lista
  }

  class "Luz" as LightState {
    +id : texto
    +encendida : lógico
    +intensidad : número
    +color : texto
  }

  class "Puerta" as DoorState {
    +abierta : lógico
  }

  class "Aire acondicionado" as AcState {
    +id : texto
    +encendido : lógico
    +modo : frío | ventilador
    +consigna : número
    +ventilador : baja | media | alta
    +compresor : lógico
    +vatios : número
  }

  class "Enchufe" as PlugState {
    +id : texto
    +encendido : lógico
    +vatios : número
    +kWh : número
  }

  class "Clima de habitación" as RoomClimate {
    +temperatura : número
    +humedad : número
    +luminosidad : número
  }

  class "Sensor de humo" as SmokeState {
    +ppm : número
    +alarma : lógico
    +simulando : lógico
  }

  class "Seguridad" as SecurityState {
    +modo : Modo de alarma
    +alarma : lógico
    +causa : texto
  }

  enum "Modo de alarma" as SecurityMode {
    desarmada
    en casa
    fuera de casa
  }

  HouseSnapshot *-- "0..*" LightState : luces
  HouseSnapshot *-- "0..*" DoorState : puertas
  HouseSnapshot *-- "0..*" AcState : aires
  HouseSnapshot *-- "0..*" PlugState : enchufes
  HouseSnapshot *-- "0..*" RoomClimate : clima
  HouseSnapshot *-- "1" SmokeState : humo
  HouseSnapshot *-- "0..1" SecurityState : seguridad
  SecurityState --> SecurityMode
}

package "Estado en la interfaz" {
  class "Órdenes" as commands <<módulo>> {
    +encenderLuz(id, cambios)
    +abrirPuerta(id, abierta)
    +ajustarAire(id, cambios)
    +armarAlarma(modo)
    +aplicarEscena(id)
    -comprobarRol(orden)
  }

  class "Almacén de la casa" as HouseStore {
    +conexión : estado del enlace
    +vistaReducida : lógico
    +aplicar(mensaje de telemetría)
    +sembrarHistorial(datos)
    +limpiarEventos()
  }

  class "Almacén de sesión" as SessionStore {
    +rol : Rol de sesión
    +usuario : texto
    +confirmaciones : pendientes
    +emparejar(clave : texto)
    +cerrarSesión()
    +atender(mensaje de sesión)
  }

  class "Almacén de la pantalla" as UiStore {
    +capas : visibles
    +paredes : modo
    +rangoHistorial : en vivo | 15 min | 1 h | 24 h
    +recorriendo : lógico
  }
}

commands ..> TelemetryAdapter : "enviar()"
commands ..> SessionStore : "comprueba el rol"
TelemetryAdapter ..> DeviceCommand : "envía"
TelemetryAdapter ..> TelemetryMessage : "recibe"
TelemetryAdapter ..> SessionMessage : "recibe"
TelemetryMessage ..> HouseSnapshot : "foto completa"
HouseStore ..> TelemetryMessage : "aplicar()"
SessionStore ..> SessionMessage : "atender()"
SessionStore --> SessionRole

@enduml
