@startuml despliegue
' Despliegue del sistema PUBLICADO. Una sola instancia de cada cosa.
' Comprobado en:
'   vercel.json                      CSP: wss:// y https:// casa-iot-nodered.onrender.com
'   render.yaml                      servicio casa-iot-nodered, plan free, Virginia, /api/health
'   infra/nodered/Dockerfile.render  imagen nodered/node-red:5.0.8-24 (Node 24)
'   infra/nodered/flows.render.json  org Dev Teams, buckets Casa_IoT y Casa_IoT_integridad
'   infra/nodered/tools/build-flows.mts   rutas /ws/casa-iot y /api
'   src/config/house.config.ts       MODEL_URL = /Iot_Casa.glb
title SmartHouse3D · Diagrama de despliegue

skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowFontSize 11
skinparam nodesep 45
skinparam ranksep 70
skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #475569
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
}
skinparam database {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
}

node "Dispositivo del usuario" <<dispositivo>> {
  node "Navegador web\nChrome, Edge, etc." <<entorno de ejecución>> {
    artifact "Interfaz en ejecución\nReact + Three.js" as ui
  }
}

node "Vercel · CDN" <<servidor>> {
  artifact "Interfaz compilada\nHTML, JS, CSS\ny el modelo Iot_Casa.glb" as dist
  artifact "vercel.json\nCSP, HSTS, X-Frame-Options" as csp
}

node "Render · Virginia · plan free\nsalud: GET /api/health" <<servidor>> {
  node "Contenedor Docker\nnodered/node-red:5.0.8-24 · Node 24" <<contenedor>> {
    artifact "Node-RED\nflows.render.json\nsolo lectura, editor apagado" as nodered
    artifact "flows_cred.json\nsolo referencias a los tokens" as cred
  }
}

node "InfluxDB Cloud · AWS us-east-1" <<servidor>> {
  node "InfluxDB 2.x · org Dev Teams" <<entorno de ejecución>> {
    database "Casa_IoT\nretención 30 días" as bdatos
    database "Casa_IoT_integridad\nretención 90 días" as bhuellas
  }
}

dist ..> ui : "<<deploy>>\nHTTPS 443\nel navegador la descarga\ny la ejecuta"
ui --> nodered : "wss://casa-iot-nodered.onrender.com/ws/casa-iot\ndatos en vivo y órdenes"
ui --> nodered : "https://casa-iot-nodered.onrender.com/api/history\nhistorial, con Authorization: Bearer"
nodered --> bdatos : "HTTPS 443\nescribe con un token\ny consulta con otro"
nodered --> bhuellas : "HTTPS 443\nhuellas de integridad"

@enduml
