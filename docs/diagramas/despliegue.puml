@startuml despliegue
' Corregido contra el proyecto real:
'   - El camino en uso es Node-RED instalado en el PC (flows.local.json) contra InfluxDB Cloud.
'     Docker (flows.json, http://influxdb:8086) queda fuera: es opcional y no esta en marcha.
'   - Se añade lo publicado: interfaz en Vercel y Node-RED en Render.
title SmartHouse3D · Diagrama de despliegue

skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowFontSize 11
skinparam nodesep 40
skinparam ranksep 60
skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #475569
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
}
skinparam database {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
}

node "Computador del usuario (Windows)" <<dispositivo>> {

  node "Navegador web\nChrome, Edge, etc." <<entorno de ejecución>> {
    artifact "Interfaz de la casa\nReact + visor 3D" as uiLocal
  }

  node "Node.js" <<entorno de ejecución>> {
    artifact "Servidor Vite\nentrega la página\ny el modelo Casa.glb" as vite
    artifact "Instaladores\nsetup-local.mjs\nredeploy-flow.mjs" as inst
  }

  node "Node-RED instalado en el PC\npuerto 1880" <<entorno de ejecución>> {
    artifact "Flujo Casa IoT\nflows.local.json\nsimula los datos, calcula\nalertas, guarda y consulta" as flujoLocal
    artifact "Nodo\nnode-red-contrib-influxdb" as nodoInflux
  }
}

node "Vercel" <<servidor en la nube>> {
  artifact "Interfaz publicada\nReact compilado con Vite" as uiProd
}

node "Render · región Virginia" <<servidor en la nube>> {
  node "Contenedor Docker\nnodered/node-red:5.0.8-24" <<contenedor>> {
    artifact "Flujo Casa IoT\nflows.render.json\neditor apagado" as flujoProd
  }
}

node "Navegador de un visitante" <<entorno de ejecución>> {
  artifact "Interfaz de la casa" as uiVisitante
}

node "InfluxDB Cloud · AWS us-east-1" <<servidor en la nube>> {
  node "InfluxDB 2.x" <<entorno de ejecución>> {
    database "Bucket Casa_IoT\nguarda 30 días" as bdatos
    database "Bucket de huellas\nguarda 90 días" as bhuellas
  }
}

' ── en el equipo del usuario ──
uiLocal --> vite : "HTTP 5173\ndescarga la página"
uiLocal --> flujoLocal : "WebSocket 1880\ndatos en vivo y órdenes"
uiLocal --> flujoLocal : "HTTP 1880\nhistorial"
inst --> flujoLocal : "HTTP 1880\ninstala el flujo"
flujoLocal --> nodoInflux : "pasa lecturas\ny consultas"
nodoInflux --> bdatos : "HTTPS 443\nguarda y consulta"
nodoInflux --> bhuellas : "HTTPS 443\nhuellas"

' ── publicado en internet ──
uiVisitante --> uiProd : "HTTPS 443\ndescarga la página"
uiVisitante --> flujoProd : "WebSocket seguro 443\ndatos en vivo y órdenes"
uiVisitante --> flujoProd : "HTTPS 443\nhistorial"
flujoProd --> bdatos : "HTTPS 443\nguarda y consulta"
flujoProd --> bhuellas : "HTTPS 443\nhuellas"

@enduml
