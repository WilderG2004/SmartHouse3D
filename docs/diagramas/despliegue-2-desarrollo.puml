@startuml despliegue-2-desarrollo
' SmartHouse3D - Diagrama de despliegue, parte 2 de 2: DESARROLLO LOCAL
' Fuentes: package.json, infra/nodered/tools/iniciar.mjs, infra/docker-compose.yml,
'          infra/setup-local.mjs, .env.example, infra/.env.example
title SmartHouse3D · Despliegue (2 de 2) · Entorno de desarrollo local

skinparam backgroundColor White
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundcorner 8
skinparam ArrowColor #334155
skinparam ArrowFontSize 11
skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #475569
}
skinparam cloud {
  BackgroundColor #EFF6FF
  BorderColor #1D4ED8
}
skinparam database {
  BackgroundColor #DBEAFE
  BorderColor #1D4ED8
}
skinparam artifact {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
}
skinparam component {
  BackgroundColor #D1FAE5
  BorderColor #047857
}

node "Equipo del desarrollador" as pc {

  node "Navegador\nlocalhost:5173" as nav {
    component "Interfaz React\nen modo desarrollo" as ui
  }

  node "Servidor de desarrollo Vite\npuerto 5173 · npm run dev" as vite {
    artifact ".env\nVITE_NODERED_WS_URL,\nVITE_API_URL,\nVITE_DEMO_OPERADOR_KEY" as envfront
  }

  node "Node-RED local\n127.0.0.1:1880 · npm run nodered:iniciar" as nrlocal {
    component "Node-RED" as nr
    artifact "flows.local.json" as flujo
    artifact "settings.js endurecido\neditor con usuario y contraseña" as settings
    artifact "infra/.env\nCASA_PAIRING_KEY, CASA_ADMIN_KEY,\nCASA_DEVICE_KEY, CASA_USERS,\ntokens de InfluxDB" as envback
  }

  node "Docker · opcional\ninfra/docker-compose.yml" as docker {
    database "InfluxDB 2.7\n127.0.0.1:8086" as influxlocal
    component "Grafana 11.6.1\nsin probar" as grafana
  }
}

cloud "InfluxDB Cloud\nus-east-1 · alternativa habitual" as influxcloud {
  database "Bucket Casa_IoT" as bcloud
}

nav --> vite : "HTTP\nrecarga en caliente"
nav --> nr : "ws://localhost:1880/ws/casa-iot"
nav --> nr : "http://localhost:1880/api/…"
nr --> influxlocal : "escribe y consulta"
nr --> bcloud : "escribe y consulta\n(camino por defecto)"
grafana ..> influxlocal : "paneles opcionales"

note right of pc
  **Los puertos solo escuchan en 127.0.0.1.**
  Node-RED se enciende siempre con
  npm run nodered:iniciar: arrancarlo con
  «node-red» a secas usaría ~/.node-red,
  escucharía en 0.0.0.0 y dejaría el editor
  sin contraseña.
end note

note bottom of envback
  infra/.env está ignorado por Git.
  Ningún secreto llega al repositorio.
end note

note bottom of docker
  Docker es opcional. El camino normal es
  Node-RED local contra InfluxDB Cloud.
end note

@enduml
