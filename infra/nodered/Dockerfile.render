# Node-RED para Render (servicio web gratuito, ver render.yaml en la raíz y infra/despliegue/README.md).
#
# Diferencia con el Dockerfile de al lado (el de docker-compose): aquí el flujo, los ajustes y el control del WebSocket
# van COPIADOS dentro de la imagen. El disco de un servicio gratuito de Render se borra en cada reinicio o despliegue;
# como el flujo es parte de la imagen, cada arranque vuelve a empezar con exactamente lo que hay en el repositorio.
#
# Lo que NO va en la imagen: ningún secreto. flows_cred.json solo trae referencias ${INFLUX_TOKEN_WRITE} y
# ${INFLUX_TOKEN_READ}; los valores reales (tokens, claves CASA_*) se escriben en el panel de Render como variables de entorno.
#
# Antes de subir cambios del flujo:  npm run render:flujo   (regenera flows.render.json)
# Contexto de construcción: esta carpeta (infra/nodered).

# Versión FIJA, la misma del Dockerfile de docker-compose (nunca :latest). Node-RED 5 solo publica imágenes con Node 24 (-24)
ARG NODERED_TAG=5.0.8-24
FROM nodered/node-red:${NODERED_TAG}

# Nodo de InfluxDB 2.x (versión exacta con la que se probó el flujo)
RUN npm install --no-audit --no-fund --omit=dev node-red-contrib-influxdb@0.7.0

# Flujo y ajustes endurecidos. Quedan de root y en solo lectura: el proceso de Node-RED (usuario node-red) los lee pero
# no puede cambiarlos. Igual el editor está apagado (no se pasa NODERED_ADMIN_HASH), así que nadie despliega desde fuera.
# /data sigue siendo del usuario node-red: ahí Node-RED escribe sus archivos internos (.config*.json, context/).
USER root
COPY --chown=root:root --chmod=444 flows.render.json /data/flows.json
COPY --chown=root:root --chmod=444 flows_cred.json settings.js seguridad-ws.js /data/
USER node-red

# Render asigna el puerto con PORT (settings.js lo lee como uiPort) y exige escuchar en todas las interfaces
ENV NODERED_BIND=0.0.0.0 \
    PORT=10000 \
    TZ=America/Bogota
EXPOSE 10000
