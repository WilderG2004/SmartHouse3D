    {
      "id": 3,
      "type": "stat",
      "title": "Costo estimado (COP)",
      "description": "kWh × 950 COP/kWh (valor de ejemplo: cambia el 950 de esta consulta por tu tarifa).",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-casa-iot"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-casa-iot"
          },
          "query": "from(bucket: \"casa_iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"power\" and r._field == \"kwh\")\n  |> last()\n  |> map(fn: (r) => ({r with _value: r._value * 950.0}))"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
