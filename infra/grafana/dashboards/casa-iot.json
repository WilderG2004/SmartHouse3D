    {
      "id": 10,
      "type": "table",
      "title": "Últimos eventos del sistema",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-casa-iot"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-casa-iot"
          },
          "query": "from(bucket: \"casa_iot\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"events\" and r._field == \"message\")\n  |> keep(columns: [\"_time\", \"level\", \"source\", \"_value\"])\n  |> group()\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 50)"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "_time": "Hora",
              "level": "Nivel",
              "source": "Origen",
              "_value": "Mensaje"
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
