# ALTERNATIVA a Caddy: nginx con límites de frecuencia y de conexiones por IP (limit_req / limit_conn).
#
# Uso: la imagen oficial de nginx sustituye las variables ${…} de los archivos *.template (DOMINIO) y guarda el
# resultado como /etc/nginx/conf.d/default.conf. Monta este archivo en /etc/nginx/templates/default.conf.template.
# Los certificados los emite Certbot (Let's Encrypt) y se montan en /etc/letsencrypt (ver README.md de esta carpeta).
#
# Mismo criterio que el Caddyfile: solo /ws/casa-iot y /api/* llegan a Node-RED; lo demás responde 404.
# NO probado con un nginx real en el entorno donde se escribió: valídalo con  nginx -t.

# ── límites por IP ──────────────────────────────────────────────────────────────────────────────────────────────
limit_conn_zone $binary_remote_addr zone=casa_conn:10m;
limit_req_zone  $binary_remote_addr zone=casa_api:10m  rate=10r/s;   # API REST: 10 peticiones/s por IP
limit_req_zone  $binary_remote_addr zone=casa_ws:10m   rate=30r/m;   # intentos de abrir el WebSocket: 30/min por IP

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
    listen 80;
    server_name ${DOMINIO};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMINIO};

    ssl_certificate     /etc/letsencrypt/live/${DOMINIO}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMINIO}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # Cuerpo máximo de las peticiones HTTP (la ingesta firmada pesa < 8 KB)
    client_max_body_size 16k;

    # WebSocket: hasta 10 conexiones simultáneas por IP; frente al tamaño de mensaje, Node-RED no tiene tope propio
    # (la librería ws acepta 100 MiB), así que el contenedor lleva límite de memoria en docker-compose.prod.yml.
    location = /ws/casa-iot {
        limit_conn casa_conn 10;
        limit_req  zone=casa_ws burst=10 nodelay;
        proxy_pass http://nodered:1880;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        # Node-RED lee la IP del cliente del ÚLTIMO valor de X-Forwarded-For (el que añade este proxy)
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
    }

    location /api/ {
        limit_req zone=casa_api burst=20 nodelay;
        proxy_pass http://nodered:1880;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / { return 404; }
}
