# Variables del BACKEND (Node-RED, InfluxDB, Grafana, proxy). Copia este archivo a  infra/.env  y rellénalo,
# o —mejor— deja que  npm run seguridad:secretos  lo cree con valores aleatorios.
#
#   infra/.env  está en .gitignore: NO lo subas nunca a Git. Este archivo (.env.example) NO lleva valores secretos.
#   Los valores que contienen «$» (el hash bcrypt) van entre comillas simples.

# ───────── Secretos (generados por npm run seguridad:secretos) ─────────
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=          # contraseña del administrador de InfluxDB
INFLUX_ADMIN_TOKEN=             # acceso TOTAL: solo para crear buckets, tokens y retención. Luego bórralo (--olvidar-admin) y pásalo por la terminal
GRAFANA_ADMIN_PASSWORD=         # contraseña de Grafana
NODERED_ADMIN_USER=admin        # usuario del EDITOR de Node-RED (no es un usuario de la casa)
NODERED_ADMIN_HASH=             # hash bcrypt de la contraseña del editor ('$2b$12$…'); sin él, el editor queda apagado
NODERED_CREDENTIAL_SECRET=      # cifra flows_cred.json en disco (mínimo 16 caracteres)

# Claves de SESIÓN. Con ellas se "empareja" una pantalla: ve el estado completo y, según el rol, puede dar órdenes.
# Una pantalla SIN emparejar solo ve luces, clima, energía y humo (ni alarma, ni movimiento, ni puertas, ni historial).
# Claves PERSONALES (recomendado): la auditoría guarda el alias de quien hizo cada cosa. Créalas con
#   npm run seguridad:secretos -- --usuario ana:operador      (rol lector | operador | administrador)
CASA_USERS=                     # alias:rol:clave,alias:rol:clave   (clave de 12+ caracteres, sin comas ni «:» en el alias)
# Claves COMPARTIDAS (alias de auditoría «compartida-operador» / «compartida-admin»):
CASA_PAIRING_KEY=               # rol Operador: luces, aires, enchufes, puertas, escenas, alarma (con confirmación)
CASA_ADMIN_KEY=                 # rol Administrador: además simulaciones, hora simulada y revocar sesiones
CASA_PAIRING_KEY_PREVIOUS=      # solo durante una rotación: la clave anterior sigue valiendo hasta que la quites
CASA_ADMIN_KEY_PREVIOUS=
# Clave maestra de la que salen las claves de cada dispositivo simulado (firmas HMAC) y la de las huellas de integridad.
CASA_DEVICE_KEY=

# Tokens de InfluxDB con UN solo permiso cada uno (los crea npm run seguridad:tokens)
INFLUX_TOKEN_WRITE=             # solo escribe: lo usa Node-RED
INFLUX_TOKEN_READ=              # solo lee: consultas del historial, Grafana y el verificador de integridad

# ───────── Ajustes (no son secretos) ─────────
INFLUX_ORG=casa
INFLUX_BUCKET=casa_iot
INFLUX_INTEGRITY_BUCKET=casa_iot_integridad   # huellas de integridad: bucket APARTE
# INFLUX_RETENTION_DAYS=30            # retención del bucket de datos (y auditoría): npm run seguridad:retencion
# INFLUX_INTEGRITY_RETENTION_DAYS=90  # retención de las huellas (InfluxDB Cloud gratuito: máximo 30)
TZ=America/Bogota
CASA_INGEST=off                 # on: acepta telemetría firmada de dispositivos externos por POST /api/ingest (exige CASA_DEVICE_KEY fija)
CASA_VERBOSE_ERRORS=on          # off en producción: los errores no revelan detalles internos
CASA_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173   # orígenes del frontend (CORS y handshake del WebSocket)
# CASA_WS_REQUIRE_ORIGIN=on     # rechaza conexiones WebSocket sin cabecera Origin (producción)
# CASA_WS_MAX_PER_IP=10         # conexiones simultáneas por IP
# CASA_WS_HANDSHAKES_PER_MIN=30 # intentos de conexión por minuto y por IP
# CASA_TRUST_PROXY=on           # SOLO si hay un proxy delante que escribe X-Forwarded-For
# NODERED_EDITOR=open           # editor SIN contraseña: solo para pruebas en tu equipo
# GRAFANA_ALLOW_EMBEDDING=false # true solo para incrustar Grafana en otra página

# ───────── Solo para el despliegue público (infra/despliegue/) ─────────
# DOMINIO=casa-api.midominio.com        # nombre público del backend (certificado Let's Encrypt)
# ACME_EMAIL=tu-correo@ejemplo.com      # aviso de caducidad del certificado
# FRONTEND_ORIGIN=https://casa-iot.vercel.app   # origen exacto de tu frontend en Vercel
